# Server
ENV=production
ADDR=:8080
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s

# Content
CONTENT_DIR=./content
STATIC_DIR=./web/static

# Contact form email
CONTACT_EMAIL_TO=hello@nuteo.example.com
CONTACT_EMAIL_FROM=noreply@nuteo.example.com

# SMTP (Gmail App Password, Mailgun, SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@nuteo.example.com
SMTP_PASS=your-smtp-password

# Security — generate with: openssl rand -hex 32
CSRF_SECRET=replace-me-with-openssl-rand-hex-32
RATE_LIMIT_RPM=5

# Site metadata
SITE_NAME=nuteo solution
SITE_URL=https://nuteo.example.com
LOGO_PATH=/static/images/logo.svg
TWITTER_HANDLE=
LINKEDIN_URL=https://www.linkedin.com/company/nuteo
GITHUB_URL=https://github.com/nuteo
